{% for place in places %}
	<twig:Avatar :player="place.player" class="!w-16 !h-16" />
	<span class="value-2">{{ place.player.name }}</span>
	<span class="value-1"><span class="ac_value" data-id="{{ place.id }}">{{ place.name }}</span> (secteur {{ place.system.sector.identifier }})</span>
{% endfor %}
