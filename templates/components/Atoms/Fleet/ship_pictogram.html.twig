{# Pictogram of a ship type (BattleShipType::$pictogram), white with a dark outline to stay readable on faction colours. #}
<img src="{{ asset('images/legacy/picto/ships/types/' ~ pictogram ~ '.svg') }}" alt="" aria-hidden="true"
	class="{{ class|default('size-5') }} shrink-0 [filter:drop-shadow(0_0_1px_rgb(0_0_0/.9))_drop-shadow(0_0_1px_rgb(0_0_0/.9))]" />
