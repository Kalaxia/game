<twig:LayoutBox class="min-w-64">
	<header>
		<twig:H2>Meilleur joueur</twig:H2>
	</header>

	<section>
		<div class="center-box">
			<span class="label">
				<twig:PlayerStatus :player="best_player" class="!w-16 !h-16" />
				de
				<twig:FactionName :faction="best_player.faction" type="popular" />
			</span>
			<span class="value">{{ best_player.name }}</span>
		</div>

		<div class="mt-4">
			<twig:Avatar :player="best_player" class="w-24 h-24" />
		</div>
	</section>
</twig:LayoutBox>
