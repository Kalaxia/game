<twig:LayoutBox class="flew-grow grow">
	<header>
		<twig:H2>
			Nomination
		</twig:H2>
	</header>

	<section class="mt-4 flex flex-col gap-y-2">
		{% set list = [
			enum('App\\Modules\\Zeus\\Domain\\Enum\\PlayerStatus').Minister,
			enum('App\\Modules\\Zeus\\Domain\\Enum\\PlayerStatus').Warlord,
			enum('App\\Modules\\Zeus\\Domain\\Enum\\PlayerStatus').Treasurer,
		] %}

		{% for status in list %}
			{% set minister = government_members|filter(minister => minister.status == status)|first %}
			<twig:MinistryCard :status="status"
							   :faction="current_player.faction"
							   :senators="senators"
							   :minister="minister is not same as(false) ? minister : null" />
		{% endfor %}
	</section>
</twig:LayoutBox>
