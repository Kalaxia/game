<div class="player color{{ this.displayFaction }}">
	<a href="{{ this.displayLink }}">
		<twig:Avatar :avatar="this.displayAvatar" class="!w-16 !h-16" />
	</a>

	<span class="title">{{ this.displayStatus }}</span>
	<strong class="name">{{ this.displayName }}</strong>
	<span class="experience">{{ this.amount|number }} crédits</span>
</div>
