<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
				  xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
				  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

	<entity name="App\Modules\Ares\Domain\Model\Battle\Battle" table="battle">
		<id name="id" column="id" type="uuid" />

		<many-to-one field="place" target-entity="App\Modules\Galaxy\Domain\Entity\Planet">
			<join-column nullable="true" on-delete="SET NULL" />
		</many-to-one>

		<many-to-many field="players" target-entity="App\Modules\Zeus\Model\Player">
			<join-table name="battle_player">
				<join-columns>
					<join-column name="battle_id" on-delete="CASCADE" />
				</join-columns>
				<inverse-join-columns>
					<join-column name="player_id" on-delete="CASCADE" />
				</inverse-join-columns>
			</join-table>
		</many-to-many>

		<field name="state" type="blob" />
		<field name="turnDuration" type="smallint" />
		<field name="startedAt" type="datetime_immutable" />
		<field name="turn" type="smallint" />
		<field name="endedAt" type="datetime_immutable" nullable="true" />
		<field name="winningSide" type="smallint" nullable="true" />
	</entity>
</doctrine-mapping>
